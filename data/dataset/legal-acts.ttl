# Dataset of EU legal acts (RDF), source of truth.
# Identifiers, titles, dates and legal relations were checked on 2026-11-03 against
# the public Cellar SPARQL endpoint of the Publications Office of the EU.
# Short names such as GDPR are informal and are not part of the official titles.

@prefix act:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/id/act/> .
@prefix body: <https://rezatashakkory.github.io/eu-governance-semantic-lab/id/body/> .
@prefix obl:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/id/obligation/> .
@prefix cpt:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/id/concept/> .
@prefix lab:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/def/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

