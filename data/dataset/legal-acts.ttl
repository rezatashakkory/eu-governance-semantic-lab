# Bodies and obligations (summaries written for this project)

body:edpb a lab:Authority ;
    rdfs:label "European Data Protection Board"@en .

body:edib a lab:Authority ;
    rdfs:label "European Data Innovation Board"@en .

body:ai-board a lab:Authority ;
    rdfs:label "European Artificial Intelligence Board"@en .

obl:notify-personal-data-breach a lab:Obligation ;
    rdfs:label "Notify a personal data breach to the supervisory authority"@en .

obl:inform-people-about-ai a lab:Obligation ;
    rdfs:label "Inform people when they interact with an AI system"@en .

obl:report-major-ict-incidents a lab:Obligation ;
    rdfs:label "Report major ICT-related incidents to the competent authority"@en .
