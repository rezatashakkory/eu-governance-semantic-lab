  <rdf:Description rdf:about="https://rezatashakkory.github.io/eu-governance-semantic-lab/id/dataset/acts">
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <dct:title xml:lang="en">EU Legal Acts on Data and AI Governance</dct:title>
    <dct:description xml:lang="en">Twenty EU legal acts on data protection, data governance, AI, open data and digital resilience, with CELEX numbers, ELI identifiers, official English titles, document dates, legal relations and links to thesaurus topics.</dct:description>
    <dct:publisher rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/id/agent/reza-tashakkori"/>
    <dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/>
    <dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/JUST"/>
    <dcat:keyword xml:lang="en">EU law</dcat:keyword>
    <dcat:keyword xml:lang="en">CELEX</dcat:keyword>
    <dcat:keyword xml:lang="en">ELI</dcat:keyword>
    <dcat:keyword xml:lang="en">linked data</dcat:keyword>
    <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-03</dct:issued>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-03</dct:modified>
    <dct:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/IRREG"/>
    <dcat:landingPage rdf:resource="https://github.com/rezatashakkory/eu-governance-semantic-lab"/>
    <dcat:distribution rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/id/distribution/acts-ttl"/>
