  <rdf:Description rdf:about="https://rezatashakkory.github.io/eu-governance-semantic-lab/id/dataset/thesaurus">
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <dct:title xml:lang="en">EU Data Governance Thesaurus</dct:title>
    <dct:description xml:lang="en">A multilingual SKOS thesaurus (English, French, German) with 68 concepts on data protection, data governance, AI governance, open data and reuse, digital resilience, and data quality and metadata. French and German labels are pending review unless taken from EuroVoc.</dct:description>
    <dct:publisher rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/id/agent/reza-tashakkori"/>
    <dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/FRA"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/DEU"/>
    <dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/GOVE"/>
    <dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/TECH"/>
    <dcat:keyword xml:lang="en">thesaurus</dcat:keyword>
    <dcat:keyword xml:lang="en">SKOS</dcat:keyword>
    <dcat:keyword xml:lang="en">data governance</dcat:keyword>
    <dcat:keyword xml:lang="en">multilingual</dcat:keyword>
    <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-03</dct:issued>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-03</dct:modified>
    <dct:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/IRREG"/>
    <dcat:landingPage rdf:resource="https://github.com/rezatashakkory/eu-governance-semantic-lab"/>
    <dcat:distribution rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/id/distribution/thesaurus-ttl"/>
    <dcat:distribution rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/id/distribution/thesaurus-jsonld"/>
    <dcat:distribution rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/id/distribution/thesaurus-rdf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rezatashakkory.github.io/eu-governance-semantic-lab/id/dataset/ontology">
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <dct:title xml:lang="en">EU Legal Acts Ontology</dct:title>
    <dct:description xml:lang="en">A small OWL ontology with classes for legal acts, regulations, directives, authorities and obligations, and properties such as amends, repeals, has topic and has CELEX number.</dct:description>
    <dct:publisher rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/id/agent/reza-tashakkori"/>
    <dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/>
    <dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/JUST"/>
    <dcat:keyword xml:lang="en">ontology</dcat:keyword>
    <dcat:keyword xml:lang="en">OWL</dcat:keyword>
    <dcat:keyword xml:lang="en">legal acts</dcat:keyword>
    <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-03</dct:issued>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-03</dct:modified>
    <dct:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/IRREG"/>
