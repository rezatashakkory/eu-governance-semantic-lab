<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dct="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:nodeID="na68464cb191e417b9f914c704d23e4edb1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="na68464cb191e417b9f914c704d23e4edb2"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/Regulation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/LegalAct"/>
    <owl:disjointWith rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/Directive"/>
    <rdfs:label xml:lang="en">Regulation</rdfs:label>
    <rdfs:comment xml:lang="en">A legal act that applies directly in all EU Member States.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/amendedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">amended by</rdfs:label>
    <rdfs:comment xml:lang="en">The subject act has its text changed by the object act.</rdfs:comment>
    <rdfs:domain rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/LegalAct"/>
    <rdfs:range rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/LegalAct"/>
    <rdfs:isDefinedBy rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/Obligation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Obligation</rdfs:label>
    <rdfs:comment xml:lang="en">A duty that a legal act places on a party.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/repeals">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label xml:lang="en">repeals</rdfs:label>
    <rdfs:comment xml:lang="en">The subject act replaces the object act, which stops being in force.</rdfs:comment>
    <rdfs:domain rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/LegalAct"/>
    <rdfs:range rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/LegalAct"/>
    <owl:inverseOf rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/repealedBy"/>
    <rdfs:isDefinedBy rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/Directive">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/LegalAct"/>
    <rdfs:label xml:lang="en">Directive</rdfs:label>
    <rdfs:comment xml:lang="en">A legal act that sets goals which Member States must reach by passing their own national laws.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/imposesObligation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">imposes obligation</rdfs:label>
    <rdfs:comment xml:lang="en">The act places the duty on a party.</rdfs:comment>
    <rdfs:domain rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/LegalAct"/>
    <rdfs:range rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/Obligation"/>
    <rdfs:isDefinedBy rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dct:title xml:lang="en">EU Legal Acts Ontology</dct:title>
    <dct:description xml:lang="en">A small OWL ontology for describing EU legal acts, how they relate to each other, and which topics from the EU Data Governance Thesaurus they cover. Independent learning project, not an official EU ontology.</dct:description>
    <dct:creator rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/id/agent/reza-tashakkori"/>
    <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-03</dct:issued>
    <dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/ImplementingRegulation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/Regulation"/>
    <rdfs:label xml:lang="en">Implementing regulation</rdfs:label>
    <rdfs:comment xml:lang="en">A regulation adopted by the Commission to set uniform conditions for applying another act.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/hasELI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has ELI</rdfs:label>
    <rdfs:comment xml:lang="en">Links an act to its European Legislation Identifier, a stable URI for legislation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/LegalAct"/>
    <rdfs:isDefinedBy rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/hasCELEX">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has CELEX number</rdfs:label>
    <rdfs:comment xml:lang="en">The CELEX number of the act, the identifier used by EUR-Lex. An act has exactly one.</rdfs:comment>
    <rdfs:domain rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/LegalAct"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/isBasedOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is based on</rdfs:label>
    <rdfs:comment xml:lang="en">The subject act is adopted on the basis of the object act, for example an implementing act and its parent act.</rdfs:comment>
    <rdfs:domain rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/LegalAct"/>
    <rdfs:range rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/LegalAct"/>
    <rdfs:isDefinedBy rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/amends">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label xml:lang="en">amends</rdfs:label>
    <rdfs:comment xml:lang="en">The subject act changes the text of the object act.</rdfs:comment>
    <rdfs:domain rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/LegalAct"/>
    <rdfs:range rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/LegalAct"/>
    <owl:inverseOf rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/amendedBy"/>
    <rdfs:isDefinedBy rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/providesFor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">provides for</rdfs:label>
    <rdfs:comment xml:lang="en">The act sets up, or requires the setting up of, the board or body.</rdfs:comment>
    <rdfs:domain rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/LegalAct"/>
    <rdfs:range rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/Authority"/>
    <rdfs:isDefinedBy rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/LegalAct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Legal act</rdfs:label>
    <rdfs:comment xml:lang="en">An act adopted by the EU institutions, such as a regulation or a directive.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na68464cb191e417b9f914c704d23e4edb2">
    <rdf:first rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/LegalAct"/>
    <rdf:rest rdf:nodeID="na68464cb191e417b9f914c704d23e4edb3"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/hasTopic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has topic</rdfs:label>
    <rdfs:comment xml:lang="en">Links an act to a concept of the EU Data Governance Thesaurus that the act covers.</rdfs:comment>
    <rdfs:domain rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/LegalAct"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/regulates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/hasTopic"/>
    <rdfs:label xml:lang="en">regulates</rdfs:label>
    <rdfs:comment xml:lang="en">Links an act to the main subject matter it regulates. Every regulated subject is also a topic of the act.</rdfs:comment>
    <rdfs:domain rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/LegalAct"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/repealedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">repealed by</rdfs:label>
    <rdfs:comment xml:lang="en">The subject act is replaced by the object act.</rdfs:comment>
    <rdfs:domain rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/LegalAct"/>
    <rdfs:range rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/LegalAct"/>
    <rdfs:isDefinedBy rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na68464cb191e417b9f914c704d23e4edb4">
    <rdf:first rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/Obligation"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/Authority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Authority</rdfs:label>
    <rdfs:comment xml:lang="en">A board or body that has tasks under a legal act.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/pendingReview">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">pending review</rdfs:label>
    <rdfs:comment xml:lang="en">A language code (for example fr or de) whose labels on this concept have not yet been checked by a native speaker.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na68464cb191e417b9f914c704d23e4edb3">
    <rdf:first rdf:resource="https://rezatashakkory.github.io/eu-governance-semantic-lab/def/Authority"/>
    <rdf:rest rdf:nodeID="na68464cb191e417b9f914c704d23e4edb4"/>
  </rdf:Description>
</rdf:RDF>
