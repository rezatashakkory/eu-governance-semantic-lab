# Broken on purpose: CELEX has type letter R (regulation) but the act is a directive.

act:broken-test a lab:Directive ;
    dct:title "A test directive"@en ;
    dct:date "2024-01-01"^^xsd:date ;
    lab:hasCELEX "32024R0001" ;
