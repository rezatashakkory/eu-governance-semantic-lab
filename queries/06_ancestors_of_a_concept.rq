# title: Ancestors of a concept
# level: intermediate
# purpose: Walk upwards from Right to erasure to the top of its branch.
# expected: 2 rows: Data subject and Data protection.
# concepts: property path with +, reading a path in the other direction
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX lab:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/def/>
PREFIX cpt:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/id/concept/>
PREFIX act:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/id/act/>
PREFIX sch:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/id/scheme/>

SELECT ?ancestor ?label
WHERE {
  # The same path as before, but the known concept is now on the left.
  cpt:right-to-erasure skos:broader+ ?ancestor .
  ?ancestor skos:prefLabel ?label .
  FILTER (lang(?label) = "en")
}
ORDER BY ?label
