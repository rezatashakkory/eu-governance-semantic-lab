# title: Direct narrower concepts
# level: easy
# purpose: List the concepts one level below Data protection.
# expected: 11 rows.
# concepts: skos:broader, one step of the hierarchy
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX lab:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/def/>
PREFIX cpt:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/id/concept/>
PREFIX act:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/id/act/>
PREFIX sch:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/id/scheme/>

SELECT ?concept ?label
WHERE {
  # Read it as: the concept has Data protection as its broader concept.
  ?concept skos:broader cpt:data-protection ;
           skos:prefLabel ?label .
  FILTER (lang(?label) = "en")
}
ORDER BY ?label
