# title: Acts about a topic, including narrower topics
# level: advanced
# purpose: Find acts that cover Data protection or any concept below it.
# expected: 6 rows: GDPR, the 1995 directive, the EU institutions regulation, ePrivacy, the Law Enforcement Directive and the Health Data Space regulation.
# concepts: alternative path with |, property path with *, joining the thesaurus to the dataset, DISTINCT
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX lab:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/def/>
PREFIX cpt:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/id/concept/>
PREFIX act:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/id/act/>
PREFIX sch:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/id/scheme/>

SELECT DISTINCT ?act ?shortName ?celex
WHERE {
  # lab:regulates is a sub-property of lab:hasTopic. Plain SPARQL does not know that,
  # so we ask for both. With reasoning turned on, hasTopic alone would be enough.
  ?act (lab:hasTopic|lab:regulates) ?topic ;
       dct:alternative ?shortName ;
       lab:hasCELEX ?celex .
  # The * means zero or more steps: the topic itself, or any narrower topic of Data protection.
  ?topic skos:broader* cpt:data-protection .
}
ORDER BY ?celex
