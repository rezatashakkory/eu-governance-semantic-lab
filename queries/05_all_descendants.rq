# title: All descendants of a concept
# level: intermediate
# purpose: List every concept below Data protection at any depth.
# expected: 14 rows: the 11 direct narrower concepts plus 3 at the second level.
# concepts: property path with +, transitive closure
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX lab:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/def/>
PREFIX cpt:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/id/concept/>
PREFIX act:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/id/act/>
PREFIX sch:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/id/scheme/>

SELECT ?concept ?label
WHERE {
  # The + means one or more steps, so this follows skos:broader again and again.
  # skos:broader is not transitive in SKOS, so the path does the work.
  ?concept skos:broader+ cpt:data-protection ;
           skos:prefLabel ?label .
  FILTER (lang(?label) = "en")
}
ORDER BY ?label
