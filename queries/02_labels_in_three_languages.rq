# title: Preferred labels in English, French and German
# level: easy
# purpose: Show every concept with its three preferred labels side by side.
# expected: 68 rows, one per concept. A missing translation would show as an empty cell.
# concepts: OPTIONAL, language tags, one variable per language
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX lab:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/def/>
PREFIX cpt:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/id/concept/>
PREFIX act:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/id/act/>
PREFIX sch:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/id/scheme/>

SELECT ?concept ?en ?fr ?de
WHERE {
  ?concept a skos:Concept ;
           skos:prefLabel ?en .
  FILTER (lang(?en) = "en")
  # OPTIONAL keeps the concept even when the translation is missing.
  OPTIONAL { ?concept skos:prefLabel ?fr . FILTER (lang(?fr) = "fr") }
  OPTIONAL { ?concept skos:prefLabel ?de . FILTER (lang(?de) = "de") }
}
ORDER BY ?en
