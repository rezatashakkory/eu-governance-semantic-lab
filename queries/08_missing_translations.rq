# title: Data quality, concepts missing a translation
# level: intermediate
# purpose: Find concepts that lack a French or a German preferred label.
# expected: 0 rows on the published data. Any row is a gap that someone should fix.
# concepts: FILTER NOT EXISTS, VALUES, data quality check
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX lab:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/def/>
PREFIX cpt:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/id/concept/>
PREFIX act:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/id/act/>
PREFIX sch:  <https://rezatashakkory.github.io/eu-governance-semantic-lab/id/scheme/>

SELECT ?concept ?enLabel ?missingLanguage
WHERE {
  ?concept a skos:Concept ;
           skos:prefLabel ?enLabel .
  FILTER (lang(?enLabel) = "en")
  # Try each language we expect, then keep the ones where no label exists.
  VALUES ?missingLanguage { "fr" "de" }
  FILTER NOT EXISTS {
    ?concept skos:prefLabel ?other .
    FILTER (lang(?other) = ?missingLanguage)
  }
}
ORDER BY ?missingLanguage ?enLabel
